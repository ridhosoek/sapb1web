APP_NAME="SAP B1 Operational Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sap_b1_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SAP_SERVICE_LAYER_URL=https://sap-server:50000/b1s/v2
SAP_COMPANY_DB=
# Comma-separated allow-list shown on the login page, for example: IA,SBODEMOUS
SAP_COMPANY_DATABASES=
SAP_USERNAME=
SAP_PASSWORD=
SAP_VERIFY_TLS=true
SAP_CONNECT_TIMEOUT_SECONDS=5
SAP_TIMEOUT_SECONDS=30
SAP_SESSION_CACHE_STORE=database
SAP_SESSION_TTL_SECONDS=1500
SAP_METADATA_TTL_SECONDS=3600
SAP_FIELD_COMMENTS=Comments
SAP_FIELD_WEB_TRANSACTION_ID=U_WebTxnId
SAP_FIELD_WEB_CREATED_BY_USER=U_UserWebSAP
SAP_FIELD_FPK_NUMBER=U_FPK
SAP_FIELD_VEHICLE=U_Nopol
SAP_FIELD_POOL=U_Pool
SAP_FIELD_DEPARTMENT=U_Department
SAP_SQL_QUERY_SERVICE_LAYER_URL=
SAP_SPAREPART_ACCOUNT_PATTERN=%5114.500%
SAP_SPAREPART_PAYMENT_ACCOUNTS=5114.5001,5114.5003
SAP_SPAREPART_CACHE_SECONDS=300
SAP_SPAREPART_HISTORY_MONTHS=24
SAP_SPAREPART_HISTORY_LIMIT=10
SAP_SPAREPART_REPORT_LIMIT=250
SAP_FIELD_PRIORITY=U_VPRIOR
SAP_STOCK_LOW_THRESHOLD=5
SAP_STOCK_WAREHOUSES=
SAP_FIELD_ISSUE_TYPE=
SAP_FIELD_DRIVER_NAME=
SAP_FIELD_CURRENT_KM=
APPROVAL_LINK_EXPIRATION_HOURS=48
SAP_DIMENSION_VEHICLE=3
SAP_DIMENSION_DEPARTMENT=1
SAP_DIMENSION_POOL=2
SAP_PR_DEPARTMENT_COSTING_FIELD=CostingCode
SAP_PR_POOL_COSTING_FIELD=CostingCode2
SAP_PR_VEHICLE_COSTING_FIELD=CostingCode3
SAP_GI_ACCOUNT_SPR_MT=
SAP_GI_ACCOUNT_SPR_KO=
SAP_GI_ACCOUNT_SPR_MEKANIK=
SAP_GI_ACCOUNT_BAN_MT=
SAP_GI_ACCOUNT_BBM_KO=
SAP_GI_DEPARTMENT_COSTING_FIELD=CostingCode
SAP_GI_POOL_COSTING_FIELD=CostingCode2
SAP_GI_VEHICLE_COSTING_FIELD=CostingCode3
SAP_GI_SERIAL_ISSUE_TYPE_CODES=BAN-MT

CONTROL_CENTER_URL=
CONTROL_CENTER_TOKEN=
CONTROL_CENTER_CONNECT_TIMEOUT_SECONDS=3
CONTROL_CENTER_TIMEOUT_SECONDS=15
CONTROL_CENTER_VERIFY_TLS=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sap.indraangkola.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
